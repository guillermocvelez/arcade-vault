# Resend API key (server-only, get one at https://resend.com/api-keys)
RESEND_API_KEY=

# Destination email for the contact form (defaults to guillermo.c.velez@gmail.com if unset)
RESEND_TO_EMAIL=

# Supabase project URL (public, exposed to the client)
SUPABASE_URL=

# Supabase anon/publishable key (public, exposed to the client)
SUPABASE_KEY=

# Supabase service role key (server-only, NEVER exposed to the client — used by
# server/api/scores.post.ts to write scores bypassing RLS). Get it from
# Project Settings -> API -> service_role key in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=
